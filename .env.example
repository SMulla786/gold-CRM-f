# Copy to .env (or .env.local) and fill in. .env and .env.local are git-ignored — never commit real values.
# Every VITE_* value is bundled into the public JS, so put nothing secret here.

# true = run against the in-browser mock API (no backend)
VITE_USE_MOCK=false

# Google AdSense (Phase 5): ads show ONLY to businesses whose current subscription term is ad-supported, never while a
# Super Admin is impersonating, and only on the allow-listed screens in src/lib/ads.ts.
# Use MANUAL ad units only: keep "Auto ads" OFF in the AdSense account, or Google may place ads on any screen.
VITE_ADS_ENABLED=false
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
VITE_ADSENSE_SLOT=0000000000

# Playwright E2E only (not VITE_*, so never bundled). Your own dev seed password — see e2e/README.md. No defaults.
E2E_PASSWORD=
# optional: superadmin's password if it differs from E2E_PASSWORD
E2E_SA_PASSWORD=
